---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import headingFontUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// All canonical/OG URLs derive from the single source of truth (site.ts).
const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
const ogImage = new URL('/og.png', site.siteUrl).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicons: SVG (dark/light aware) with .ico + apple-touch fallbacks. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- theme-color tracks --bg for the *chosen* theme, not the OS one: the
         scripts below resolve it pre-paint and ThemeToggle keeps it in sync. -->
    <meta name="theme-color" content="#0b0e14" />

    <!-- Open Graph + Twitter card (one static OG image serves both pages). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Pre-paint theme: localStorage -> prefers-color-scheme -> dark.
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (e) {
          /* no localStorage: fall through to the default */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script is:inline>
      // Browser chrome follows the theme resolved above. Hexes mirror --bg in
      // tokens.css, which isn't parsed yet at this point; after first paint
      // ThemeToggle reads the real token instead.
      (function () {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.content =
            document.documentElement.dataset.theme === 'light' ? '#fafbfd' : '#0b0e14';
        }
      })();
    </script>
    <link rel="preload" href={headingFontUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <div class="ambient" aria-hidden="true">
      <div class="ambient-orb ambient-orb-violet"></div>
      <div class="ambient-orb ambient-orb-green"></div>
    </div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  /*
   * Ambient background — spec 016. Glass only reads as glass when something
   * colourful sits behind it, so this fixed decorative layer washes --bg with
   * soft identity-coloured orbs (violet dominant, green secondary). Pure CSS,
   * no requests, never interactive, and always behind <main>: z-index -1 paints
   * it above the canvas background and below every in-flow element.
   * Two orbs, not three, and kept diagonally apart at every viewport: where two
   * orbs overlap their tints compound, and the light theme has no contrast
   * budget for that. Deliberately static — see this spec's Implementation notes.
   */
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    contain: strict;

    --orb-violet: rgb(127 82 255 / 0.14);
    --orb-green: rgb(61 220 132 / 0.1);
  }

  /* Light theme runs weaker on violet than the spec's suggested 8–12%: violet
     is a dark hue on a white page, and --accent (#0b8043) clears 4.5:1 on flat
     --bg by only 0.35, so a 10% violet wash drops .section-label to 4.21:1.
     Green is a light hue and costs far less. Measured — see the spec's
     Implementation notes. */
  :global([data-theme='light']) .ambient {
    --orb-violet: rgb(127 82 255 / 0.045);
    --orb-green: rgb(61 220 132 / 0.085);
  }

  .ambient-orb {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  /* Sized against vmin, not vw: on a short landscape viewport a vw-sized orb
     is taller than the screen and the two would meet in the middle. */
  .ambient-orb-violet {
    width: min(58rem, 130vmin);
    top: -22%;
    right: -18%;
    background: radial-gradient(circle, var(--orb-violet), transparent 68%);
  }

  .ambient-orb-green {
    width: min(46rem, 110vmin);
    bottom: -16%;
    left: -18%;
    background: radial-gradient(circle, var(--orb-green), transparent 68%);
  }
</style>
