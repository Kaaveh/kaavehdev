---
// YouTube — spec 009. Featured-channel highlight for Code With Kaaveh,
// rendered from `src/data/channels.ts` and `src/data/videos.ts`; no resume
// facts live in this component. Per specs/000-overview.md, no third-party
// iframes at page load — and since 2026-09-04 no iframes at all: each video
// card is a plain link out to YouTube (see Implementation notes in spec 009).
import { channels } from '../../data/channels';
import { featuredVideos } from '../../data/videos';

const featuredChannel = channels.find((channel) => channel.featured);
if (!featuredChannel?.url) {
  throw new Error('YouTube section requires a featured channel with a url');
}
---

<section id="youtube" class="section youtube">
  <div class="container">
    <p class="section-label reveal">// youtube</p>
    <h2 class="youtube-title reveal" data-reveal-delay="80">Code With Kaaveh</h2>

    <div class="channel-card glass-card glass-card-strong reveal hover-lift" data-reveal-delay="140">
      <svg
        class="channel-icon"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
        ></path>
      </svg>
      <div class="channel-body">
        <h3 class="channel-name">{featuredChannel.name}</h3>
        <p class="channel-tagline">{featuredChannel.tagline}</p>
      </div>
      <a
        class="channel-cta"
        href={featuredChannel.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        Watch on YouTube <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      featuredVideos.length > 0 && (
        <ul class="video-grid" role="list">
          {featuredVideos.map((video, index) => (
            <li class="video-item reveal" data-reveal-delay={200 + index * 80}>
              <a
                class="video-link"
                href={`https://www.youtube.com/watch?v=${video.id}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="video-frame">
                  <img
                    class="video-thumb"
                    src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                  />
                  <span class="play-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M8.6 6.4 17.4 12 8.6 17.6Z"
                        fill="currentColor"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </span>
                <span class="video-title">{video.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="beyond-link reveal">
      <a class="more-link" href="/beyond#channels">More channels — beyond code →</a>
    </p>
  </div>
</section>

<style>
  /* YouTube brand red — a deliberate, scoped exception to the site's accent
     system (spec 009 originally kept this section on-palette; Kaaveh asked
     2026-09-03 for the platform's own red on its icon/CTA). Not promoted to
     tokens.css: it belongs to this section only. */
  .youtube {
    --youtube-red: #ff0000;
    --youtube-red-hover: #d90000;
  }

  .youtube-title {
    margin-block-start: var(--space-2);
  }

  /* Fill/border/radius/shadow/sheen come from .glass-card(-strong) — spec
     017, -strong since .channel-tagline is body-size text. */
  .channel-card {
    margin-block-start: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .channel-icon {
    flex: none;
    color: var(--youtube-red);
  }

  .channel-body {
    flex: 1 1 16rem;
  }

  .channel-name {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    color: var(--text);
  }

  .channel-tagline {
    margin-block-start: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  /* Bold CTA, matching the Hero (004) primary button treatment — YouTube red
     instead of the brand gradient (see .youtube above). Black label text
     keeps AA contrast (~5.25:1 on #ff0000; white would only clear ~4:1). */
  .channel-cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--youtube-red);
    color: #000;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform var(--transition),
      background-color var(--transition);
  }

  .channel-cta:hover,
  .channel-cta:focus-visible {
    background: var(--youtube-red-hover);
    transform: translateY(-2px);
  }

  .video-grid {
    list-style: none;
    margin: 0;
    margin-block-start: var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .video-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .video-item {
    display: flex;
  }

  /* Whole card is one link out to YouTube (thumbnail + title), so the click
     target matches what people expect from a video card and there is a single
     tab stop per video. */
  .video-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Inlay, not glass: the thumbnail chrome, named explicitly in spec 017 as an
     inlay — no backdrop-filter here either. */
  .video-frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--glass-inlay-bg);
  }

  .video-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Centre scrim under the play disc. A translucent white button reads
     beautifully over a dark thumbnail and disappears over a bright one (and
     over the bare inlay, when a thumbnail 404s), so darken just the middle of
     the frame — the same trick Telegram's video preview uses. */
  .video-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0.3) 13%, transparent 26%);
    pointer-events: none;
  }

  /* Telegram-style play affordance: a large, translucent white disc with a
     white triangle, sitting over the thumbnail rather than a solid brand-red
     chip. Sized as a share of the frame width so it stays proportional from
     320 px to a 3-up desktop grid. */
  .play-icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 15%, 3.75rem);
    aspect-ratio: 1;
    background: rgb(255 255 255 / 0.28);
    border: 1px solid rgb(255 255 255 / 0.45);
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.35);
    transition:
      transform var(--transition),
      background-color var(--transition);
  }

  /* A drawn triangle, not the ▶ glyph: font rendering gave that character an
     asymmetric bounding box (it needed a manual padding nudge to look
     centered, and the nudge only worked for one specific font/browser). The
     path is nudged ~1 unit right of the viewBox centre on purpose — a
     geometrically centred triangle reads as sitting too far left inside a
     circle. Rounded joins come from the stroke, matching Telegram's icon. */
  .play-icon svg {
    width: 42%;
    height: 42%;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .video-link:hover .play-icon,
  .video-link:focus-visible .play-icon {
    background: rgb(255 255 255 / 0.42);
    transform: scale(1.08);
  }

  .video-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .video-title {
    font-size: 0.9375rem;
    color: var(--text-2);
    line-height: 1.4;
    transition: color var(--transition);
  }

  .video-link:hover .video-title,
  .video-link:focus-visible .video-title {
    color: var(--text);
  }

  .beyond-link {
    margin-block-start: var(--space-6);
  }

  .more-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color var(--transition),
      transform var(--transition);
  }

  .more-link:hover,
  .more-link:focus-visible {
    color: var(--accent);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-cta,
    .play-icon,
    .video-title,
    .more-link {
      transition: none;
    }

    .channel-cta:hover,
    .channel-cta:focus-visible,
    .video-link:hover .play-icon,
    .video-link:focus-visible .play-icon,
    .more-link:hover,
    .more-link:focus-visible {
      transform: none;
    }
  }
</style>
